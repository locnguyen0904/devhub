# Copy to .env and fill in. The .env file is gitignored; Makefile loads it.

# --- Required ---
DATABASE_URL=postgres://devhub:devhub@localhost:5432/devhub?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# HMAC key for signing access-token JWTs. Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional (defaults shown) ---
# APP_ENV=development          # "production" turns on JSON logs and Secure cookies
# PORT=8080
# FRONTEND_URL=http://localhost:5173
# Must match the callback registered on the GitHub OAuth app exactly.
# GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
